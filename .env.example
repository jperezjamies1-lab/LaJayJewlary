# Database (PostgreSQL recommended; Prisma also supports SQLite for local dev)
DATABASE_URL="postgresql://user:password@localhost:5432/jaylajoyeria"

# AI Concierge — Anthropic API key (used server-side only, never exposed to the client)
ANTHROPIC_API_KEY="sk-ant-..."

# Admin auth
JWT_SECRET="replace-with-a-long-random-string"

# Initial admin account — required by prisma/seed.ts, never hardcoded.
# ADMIN_PASSWORD must be at least 12 characters. Rotate/remove after first login if desired.
ADMIN_EMAIL="owner@jaylajoyeria.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Store Owner"

# Cloudflare R2 (S3-compatible object storage) — product images, banners,
# reviews, payment screenshots, everything in the Media Library.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://media.jaylajoyeria.com"

# Transactional email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Jay La Joyería <no-reply@jaylajoyeria.com>"

# Site
NEXT_PUBLIC_SITE_URL="https://jaylajoyeria.com"
