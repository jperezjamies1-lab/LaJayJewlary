# Database (PostgreSQL recommended; Prisma also supports SQLite for local dev)
DATABASE_URL="postgresql://user:password@localhost:5432/jaylajoyeria"

# Admin auth
JWT_SECRET="replace-with-a-long-random-string"

# Initial admin account — required by prisma/seed.ts, never hardcoded.
# ADMIN_PASSWORD must be at least 12 characters. Rotate/remove after first login if desired.
ADMIN_EMAIL="owner@jaylajoyeria.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Store Owner"

# Supabase Storage — required. Two buckets on your existing Supabase project:
#   public-media    (public)  — product images, logo, banners, collections, reviews
#   payment-proofs  (private) — Zelle payment screenshots, never public
# SUPABASE_SERVICE_ROLE_KEY has full storage access — server-side only, never
# expose it to browser code or a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Concierge — OPTIONAL. Leave unset to run the store with no AI chat;
# the widget hides itself automatically and everything else (search,
# products, checkout, orders, admin) works normally either way.
ANTHROPIC_API_KEY=""

# Transactional email (Resend) — optional; account creation/orders still work
# without it, emails are just skipped with a logged warning.
RESEND_API_KEY=""
EMAIL_FROM="Jay La Joyería <no-reply@jaylajoyeria.com>"

# Site
NEXT_PUBLIC_SITE_URL="https://jaylajoyeria.com"
